			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Read Google project metadata",
			"type": "shell",
			"command": "$key = Get-Content -Raw 'authgoogle/client_secret_842682596515-tfjs8bmhh6qhdnnuivb5d6qltbuq2u9c.apps.googleusercontent.com.json' | ConvertFrom-Json; $client = if ($key.web) { $key.web } else { $key.installed }; [PSCustomObject]@{ ProjectId = $client.project_id; HasClientId = [bool]$client.client_id; HasClientSecret = [bool]$client.client_secret }",
			"isBackground": false,
