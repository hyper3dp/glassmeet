			"type": "shell",
			"command": "git.exe",
			"args": [
				"commit",
				"-m",
				"Repair GitHub Pages dependency install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Commit dependency repair",
			"type": "shell",
			"command": "git.exe",
			"args": [
				"commit",
				"-m",
				"Repair GitHub Pages dependency install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Push dependency repair",
			"type": "shell",
			"command": "git.exe",
			"args": [
				"push",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Normalize package manifest casing",
			"type": "shell",
			"command": "git.exe mv Package.json package.tmp; git.exe mv package.tmp package.json",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Validate lowercase package manifest",
			"type": "shell",
			"command": "git.exe",
			"args": [
				"ls-files",
				"*ackage.json"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Test Pages-prefixed build",
			"type": "shell",
			"command": "$env:VITE_BASE_PATH = '/glassmeet/'; npm.cmd run build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Recheck Pages build",
			"type": "shell",
			"command": "$env:VITE_BASE_PATH = '/glassmeet/'; npm.cmd run build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Verify project Pages paths",
			"type": "shell",
			"command": "$env:VITE_BASE_PATH = '/glassmeet/'; npm.cmd run build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Check final Pages tree",
			"type": "shell",
			"command": "git.exe",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Check package tracked case",
			"type": "shell",
			"command": "git.exe",
			"args": [
