			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Push Pages setup to GitHub",
			"type": "shell",
			"command": "git.exe",
			"args": [
				"push",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Reproduce Pages install",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"ci"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GlassMeet: Final Pages build",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
